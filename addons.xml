<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
    id="repository.cinetv"
    name="CineTV Repository"
    version="0.0.1"
    provider-name="CineTV">

    <extension
        point="xbmc.addon.repository"
        name="CineTV Repository">

        <dir>
            <info compressed="false">
                https://thuviencine.github.io/repo/addons.xml
            </info>

            <checksum>
                https://thuviencine.github.io/repo/addons.xml.md5
            </checksum>

            <datadir zip="true">
                https://thuviencine.github.io/repo/zips/
            </datadir>
        </dir>

    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>CineTV Repository</summary>
        <description>CineTV Kodi Repository</description>
        <platform>all</platform>
    </extension>

</addon>
